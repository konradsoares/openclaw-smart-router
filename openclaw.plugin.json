{
  "id": "smart-router",
  "name": "Smart Router (Local / Colab / Cloud)",
  "description": "Telegram routing across local, Colab MCP gateway, and cloud.",
  "activation": {
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "route",
          "observe",
          "cloud-only"
        ],
        "default": "route"
      },
      "telegramMode": {
        "type": "string",
        "enum": [
          "off",
          "prefix",
          "native"
        ],
        "default": "off",
        "description": "prefix intercepts !route commands; native leaves Telegram turns to OpenClaw and chooses model through hooks; off disables interception."
      },
      "telegramPrefix": {
        "type": "string",
        "default": "!route"
      },
      "localAgent": {
        "type": "string",
        "default": "pair"
      },
      "cloudAgent": {
        "type": "string",
        "default": "main"
      },
      "localMaxChars": {
        "type": "integer",
        "minimum": 50,
        "maximum": 10000,
        "default": 800
      },
      "maxPromptChars": {
        "type": "integer",
        "minimum": 100,
        "maximum": 8000,
        "default": 1500
      },
      "dispatcherTimeoutSeconds": {
        "type": "integer",
        "minimum": 10,
        "maximum": 300,
        "default": 45
      },
      "allowedTelegramIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "deliveryMethod": {
        "type": "string",
        "enum": [
          "cli"
        ],
        "default": "cli"
      },
      "colabGatewayUrl": {
        "type": "string",
        "default": "http://127.0.0.1:18080/v1/chat/completions"
      },
      "colabEnvFile": {
        "type": "string"
      },
      "colabTimeoutSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 300
      },
      "colabFallback": {
        "type": "string",
        "enum": [
          "pair",
          "none"
        ],
        "default": "pair"
      },
      "allowCloudFallback": {
        "type": "boolean",
        "default": false,
        "description": "Allow paid cloud fallback after a failed automatic local request."
      },
      "colabProgress": {
        "type": "boolean",
        "default": true,
        "description": "Send Telegram status messages for explicit Colab requests."
      },
      "colabProgressDelaySeconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 120,
        "default": 15
      },
      "replyInUserLanguage": {
        "type": "boolean",
        "default": true,
        "description": "Direct Colab replies use the latest user language."
      },
      "nativeRouting": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "pairModelsUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8080/v1/models"
          },
          "localModels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model",
                "contextWindow"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 1024
                },
                "maxOutputTokens": {
                  "type": "integer",
                  "minimum": 64
                },
                "supportsTools": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "default": []
          },
          "colabModel": {
            "type": "string",
            "default": ""
          },
          "cloudModel": {
            "type": "string",
            "default": ""
          },
          "allowPaidCloud": {
            "type": "boolean",
            "default": false
          },
          "systemTokens": {
            "type": "integer",
            "minimum": 0,
            "default": 6000,
            "description": "Minimum 6000 effective tokens are reserved for the OpenClaw runtime regardless of this setting; observed staging preflight exceeded 5900 tokens."
          },
          "unknownHistoryTokens": {
            "type": "integer",
            "minimum": 0,
            "default": 2048
          },
          "toolTokens": {
            "type": "integer",
            "minimum": 0,
            "default": 2000
          },
          "safetyFraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.15
          },
          "colabContextWindow": {
            "type": "integer",
            "minimum": 1024,
            "default": 4096
          },
          "colabMaxOutputTokens": {
            "type": "integer",
            "minimum": 64,
            "default": 1024
          },
          "forceCommandsEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable staging-only explicit !pair and !colab model selection in an existing Telegram session. Disabled by default."
          }
        }
      },
      "dualMode": {
        "type": "object",
        "additionalProperties": false,
        "description": "Experimental authorized Telegram !dual command, disabled by default; serial PAIR analysis then Colab critique.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "productionEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Explicit production-only delivery gate; requires production profile configuration and manual approval. Default false."
          },
          "pairUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8080/v1/chat/completions"
          },
          "background": {
            "type": "boolean",
            "default": false,
            "description": "Return Telegram hook immediately while an in-process staging-only dual job sends progress and results. Jobs do not survive restart."
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "description": "Read-only PAIR model inventory evidence for dual review; no command execution or web access.",
            "properties": {
              "enabled": {"type": "boolean", "default": false},
              "inventoryUrl": {"type": "string", "default": "http://127.0.0.1:8080/v1/models"},
              "serverPropsEnabled": {"type": "boolean", "default": false, "description": "Opt-in read-only GET of local llama-server /props; never exposes model paths or templates."},
              "propsUrl": {"type": "string", "default": "http://127.0.0.1:8080/props"}
            }
          },
          "continuity": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in durable next-turn context injection through the supported OpenClaw session workflow API; not a transcript rewrite.",
            "properties": {"enabled": {"type": "boolean", "default": false}}
          },
          "resilience": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in bounded retries for transient Colab gateway HTTP 502/503/504 in direct dual mode only. Never routes to paid APIs.",
            "properties": {
              "enabled": {"type": "boolean", "default": false},
              "maxRetries": {"type": "integer", "minimum": 0, "maximum": 2, "default": 1}
            }
          },
          "research": {
            "type": "object",
            "additionalProperties": false,
            "description": "Opt-in bounded official-document lookups for dual review. No general browsing or user-provided URLs.",
            "properties": {"enabled": {"type": "boolean", "default": false}}
          }
        }
      }
    }
  }
}
